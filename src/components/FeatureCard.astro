---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
  text?: string;
}

const { icon, title, text } = Astro.props;
---

<div class="feature-card card">
  <span class="icon-chip" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <h3 class="feature-card__title">{title}</h3>
  {text && <p class="feature-card__text">{text}</p>}
</div>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    height: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .feature-card__title {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .feature-card__text {
    color: var(--color-text-soft);
    line-height: 1.6;
  }
</style>
