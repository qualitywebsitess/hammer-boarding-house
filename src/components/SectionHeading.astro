---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
}

const { eyebrow, title, lead, align = 'left', id } = Astro.props;
---

<header class:list={['section-heading', align === 'center' && 'section-heading--center']}>
  {eyebrow && <span class:list={['eyebrow', align === 'center' && 'eyebrow--plain']}>{eyebrow}</span>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
</style>
