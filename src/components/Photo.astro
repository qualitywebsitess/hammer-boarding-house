---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ImageRatio } from '../data/images';

interface Props {
  image?: ImageMetadata;
  alt: string;
  ratio: ImageRatio;
  radius?: 'none' | 'sm' | 'md' | 'lg';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** Marks the image as LCP: eager + high fetch priority. */
  priority?: boolean;
  /** Copy shown in the empty slot until a real photograph is supplied. */
  placeholderLabel?: string;
  class?: string;
}

const {
  image,
  alt,
  ratio,
  radius = 'md',
  sizes = '(min-width: 900px) 50vw, 100vw',
  loading = 'lazy',
  priority = false,
  placeholderLabel = 'Photography coming soon',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['photo', `photo--radius-${radius}`, className]}
  style={`--photo-ratio: ${ratio.replace('/', ' / ')};`}
>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1280, 1920]}
        sizes={sizes}
        loading={priority ? 'eager' : loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="photo__img"
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={alt}>
        <svg viewBox="0 0 24 24" class="photo__icon" aria-hidden="true" focusable="false">
          <path
            d="M4 6h3l1.6-2.2h6.8L17 6h3a1.8 1.8 0 0 1 1.8 1.8v10.4A1.8 1.8 0 0 1 20 20H4a1.8 1.8 0 0 1-1.8-1.8V7.8A1.8 1.8 0 0 1 4 6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="13" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span class="photo__label">{placeholderLabel}</span>
      </div>
    )
  }
</div>

<style>
  .photo {
    width: 100%;
    aspect-ratio: var(--photo-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .photo--radius-none {
    border-radius: 0;
  }
  .photo--radius-sm {
    border-radius: var(--radius-sm);
  }
  .photo--radius-md {
    border-radius: var(--radius-md);
  }
  .photo--radius-lg {
    border-radius: var(--radius-lg);
  }

  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Warm sand slot (Stitch .placeholder-bg) — reads as part of the design
     while real photography is pending. */
  .photo__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
    background: var(--color-placeholder);
    color: var(--color-text-soft);
    border-radius: inherit;
  }

  .photo__icon {
    width: 1.9rem;
    height: 1.9rem;
    opacity: 0.55;
  }

  .photo__label {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-align: center;
    padding-inline: var(--space-4);
  }
</style>
