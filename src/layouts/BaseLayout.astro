---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { whatsappLinks } from '../data/whatsapp';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Structured data uses only client-verified facts.
// No address, no geo coordinates, no ratings — none were supplied.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.description,
  telephone: site.phoneDisplay,
  email: site.email,
  url: canonicalURL.href,
  priceRange: `${site.currency}${site.priceMin} - ${site.currency}${site.priceMax}`,
  amenityFeature: site.includedInRent.map((name) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf9f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZM" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <a
      class="floating-whatsapp"
      href={whatsappLinks.general}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path
          d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2 22l5.35-1.4a9.83 9.83 0 0 0 4.69 1.19h.01c5.43 0 9.85-4.42 9.85-9.86 0-2.63-1.02-5.11-2.88-6.97A9.79 9.79 0 0 0 12.04 2Zm5.76 14.1c-.24.68-1.4 1.3-1.94 1.35-.5.05-.96.23-3.23-.68-2.72-1.08-4.45-3.85-4.58-4.03-.14-.18-1.1-1.46-1.1-2.79s.7-1.98.95-2.25c.25-.27.54-.34.72-.34.18 0 .36 0 .52.01.17.01.4-.06.62.48.24.57.8 1.98.87 2.12.07.14.12.31.02.5-.1.18-.14.29-.28.45-.14.16-.3.36-.42.48-.14.14-.29.29-.12.57.16.27.73 1.2 1.56 1.95 1.08.96 1.98 1.26 2.26 1.4.28.14.44.12.6-.07.17-.2.7-.82.89-1.1.18-.28.37-.23.62-.14.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.11.07.66-.17 1.34Z"
        ></path>
      </svg>
      <span class="visually-hidden">Chat with Hammer Boarding House on WhatsApp</span>
    </a>

    <style>
      .floating-whatsapp {
        position: fixed;
        right: var(--space-4);
        bottom: var(--space-4);
        z-index: 60;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: var(--radius-pill);
        background: var(--color-whatsapp);
        color: var(--color-on-whatsapp);
        box-shadow: var(--shadow-lg);
        transition: background-color 0.15s ease, transform 0.15s ease;
      }

      .floating-whatsapp svg {
        width: 30px;
        height: 30px;
      }

      .floating-whatsapp:hover {
        background: var(--color-whatsapp-dark);
        color: #fff;
        transform: translateY(-2px);
      }

      /* Hidden once the desktop nav (and its WhatsApp CTA) is visible. */
      @media (min-width: 1000px) {
        .floating-whatsapp {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .floating-whatsapp:hover {
          transform: none;
        }
      }
    </style>
  </body>
</html>
